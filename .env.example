# Required for the main deployed web prototype
GOOGLE_MAPS_API_KEY=
AI_PROVIDER=xiaomi
UNIFIED_AI_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional storage/logging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider overrides
AI_BASE_URL=https://api.deepseek.com
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v-flash
LLM_MODEL=deepseek-chat
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_TEXT_MODEL=mimo-v2-flash
XIAOMI_VISION_MODEL=mimo-v2-omni
XIAOMI_TEMPERATURE=0.8
XIAOMI_TOP_P=0.95
XIAOMI_MAX_TOKENS=4096

# Optional separate keys if you do not want to reuse UNIFIED_AI_API_KEY
AI_API_KEY=
GLM_API_KEY=
XIAOMI_API_KEY=

# Optional fallback street image provider
MAPILLARY_ACCESS_TOKEN=

# Optional cloud TTS
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# Local-only CosyVoice sidecar
LOCAL_TTS_ENDPOINT=http://127.0.0.1:7860/tts
VOICE_ACCENT_PRESET=Hong Kong bilingual
COSYVOICE_REPO=
COSYVOICE_MODEL_DIR=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE_REFERENCE_AUDIO=
COSYVOICE_PUBLIC_BASE_URL=http://127.0.0.1:7860
