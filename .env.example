# Required on Vercel
# This key is public by design for Google Maps JavaScript. Restrict it to your Vercel domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
STORY_REPAIR_TOKEN=
NEXT_PUBLIC_APP_URL=https://neonhk.vercel.app

# Optional model/base URL overrides
GEMINI_MODEL=gemini-3-flash-preview
WIKIMEDIA_USER_AGENT=HKSpatialStory/1.0 (https://neonhk.vercel.app/)

# Optional storage/logging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CROP_BUCKET=fragment-crops

# Optional fallback street image provider
MAPILLARY_ACCESS_TOKEN=

# Optional cloud TTS
TTS_PROVIDER=minimax
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_PROMPT=Voice direction: calm, premium documentary narrator for a Hong Kong spatial story. Use clear English, measured pacing, short pauses, restrained warmth, and a reflective but not theatrical tone.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_ENDPOINT=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE_ID=male-qn-qingse
MINIMAX_TTS_VOICE_ID_ALT=
MINIMAX_TTS_VOICE_ID_FEMALE=

# Local-only CosyVoice sidecar
LOCAL_TTS_ENDPOINT=http://127.0.0.1:7860/tts
VOICE_ACCENT_PRESET=Hong Kong bilingual
COSYVOICE_REPO=
COSYVOICE_MODEL_DIR=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE_REFERENCE_AUDIO=
COSYVOICE_PUBLIC_BASE_URL=http://127.0.0.1:7860
