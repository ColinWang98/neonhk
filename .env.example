# Required on Vercel
# This key is public by design for Google Maps JavaScript. Restrict it to your Vercel domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
AI_API_KEY=
GLM_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional model/base URL overrides
AI_BASE_URL=https://api.deepseek.com
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=deepseek-chat
VISION_MODEL=glm-4.6v-flash
AI_PROVIDER=deepseek
VISION_PROVIDER=glm

# Optional storage/logging
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback street image provider
MAPILLARY_ACCESS_TOKEN=

# Optional cloud TTS
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=

# Local-only CosyVoice sidecar
LOCAL_TTS_ENDPOINT=http://127.0.0.1:7860/tts
VOICE_ACCENT_PRESET=Hong Kong bilingual
COSYVOICE_REPO=
COSYVOICE_MODEL_DIR=FunAudioLLM/Fun-CosyVoice3-0.5B-2512
COSYVOICE_REFERENCE_AUDIO=
COSYVOICE_PUBLIC_BASE_URL=http://127.0.0.1:7860
